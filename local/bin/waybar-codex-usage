#!/usr/bin/env python3
import json
import subprocess
import sys
from datetime import datetime


def emit(text, tooltip, style_class):
    print(json.dumps({"text": text, "tooltip": tooltip, "class": style_class}))


try:
    result = subprocess.run(
        ["codexbar", "usage", "--provider", "codex", "--format", "json", "--no-color"],
        stdout=subprocess.PIPE,
        check=True,
        text=True,
        timeout=20,
    )
    providers = json.loads(result.stdout)
    usage = next(provider["usage"] for provider in providers if provider["provider"] == "codex")
    windows = (usage.get("primary"), usage.get("secondary"), usage.get("tertiary"))
    window = next(window for window in windows if window and window.get("windowMinutes") == 10080)
    used = round(float(window["usedPercent"]))
    remaining = max(0, 100 - used)
    reset_at = datetime.fromisoformat(window["resetsAt"].replace("Z", "+00:00")).astimezone()

    if used >= 95:
        style_class = "critical"
    elif used >= 80:
        style_class = "warning"
    else:
        style_class = "normal"

    emit(
        f"󰚩  {remaining}%",
        f"Codex Weekly Usage\n{used}% used · {remaining}% remaining\nResets {reset_at:%a %d %b, %H:%M}",
        style_class,
    )
except Exception as error:
    print(f"Codex usage unavailable: {type(error).__name__}", file=sys.stderr)
    emit("󰚩  ?", "Codex weekly usage unavailable", "unavailable")

#!/usr/bin/env bash
set -euo pipefail

direction=${1:?direction required}
case "$direction" in
  l|r|u|d) ;;
  *)
    echo "Invalid direction: $direction" >&2
    exit 1
    ;;
esac

active_window=$(hyprctl activewindow -j)
active_address=$(jq -r '.address' <<<"$active_window")
active_group_count=$(jq -r '.grouped | length' <<<"$active_window")

if ((active_group_count > 0)); then
  active_group_index=$(jq -r --arg active_address "$active_address" '.grouped | index($active_address)' <<<"$active_window")

  case "$direction" in
    l|u)
      if ((active_group_index > 0)); then
        hyprctl dispatch 'hl.dsp.group.prev()'
      fi
      ;;
    r|d)
      if ((active_group_index < active_group_count - 1)); then
        hyprctl dispatch 'hl.dsp.group.next()'
      fi
      ;;
  esac
else
  hyprctl dispatch "hl.dsp.focus({ direction = \"$direction\" })"
fi
